<?xml version="1.0" encoding="utf-8"?> 
<androidx.constraintlayout.widget.ConstraintLayout 
xmlns:android="http://schemas.android.com/apk/res/android" 
    xmlns:app="http://schemas.android.com/apk/res-auto" 
    xmlns:tools="http://schemas.android.com/tools" 
    android:layout_width="match_parent" 
    android:layout_height="match_parent" 
    tools:context=".VotingActivity"> 
    <ImageView 
        android:id="@+id/imageView" 
        android:layout_width="416dp" 
        android:layout_height="737dp" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintEnd_toEndOf="parent" 
        app:layout_constraintHorizontal_bias="0.6" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintTop_toTopOf="parent" 
        app:srcCompat="@drawable/background" /> 
 
    <TextView 
        android:id="@+id/textView2" 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content" 
        android:backgroundTint="#2A61B5" 
        android:text="Welcome To Voting Page" 
        android:textSize="33dp" 
        android:textStyle="bold" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintEnd_toEndOf="parent" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintTop_toTopOf="@+id/imageView" 
        app:layout_constraintVertical_bias="0.087" /> 
 
    <Button 
        android:id="@+id/buttonBJP" 
        android:layout_width="250dp" 
        android:layout_height="65dp" 
        android:backgroundTint="#2A61B5" 
        android:text="BJP" 
        android:textSize="25dp" 
        app:icon="@drawable/bjp" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintEnd_toEndOf="parent" 
        app:layout_constraintHorizontal_bias="0.496" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintTop_toTopOf="@+id/imageView" 
        app:layout_constraintVertical_bias="0.257" /> 
 
    <Button 
        android:id="@+id/buttonCongress" 
        android:layout_width="250dp" 
        android:layout_height="65dp" 
        android:backgroundTint="#2A61B5" 
        android:text="CONGRESS" 
        android:textSize="25dp" 
        app:icon="@drawable/congress" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintEnd_toEndOf="parent" 
        app:layout_constraintHorizontal_bias="0.496" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintTop_toTopOf="@+id/imageView" 
        app:layout_constraintVertical_bias="0.392" /> 
 
    <Button 
        android:id="@+id/buttonAAP" 
        android:layout_width="250dp" 
        android:layout_height="65dp" 
        android:backgroundTint="#2A61B5" 
        android:text="AAP" 
        android:textSize="25dp" 
        app:icon="@drawable/aap" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintEnd_toEndOf="parent" 
        app:layout_constraintHorizontal_bias="0.496" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintTop_toTopOf="@+id/imageView" 
        app:layout_constraintVertical_bias="0.525" /> 
 
    <Button 
        android:id="@+id/buttonOthers" 
        android:layout_width="250dp" 
        android:layout_height="65dp" 
        android:backgroundTint="#2A61B5" 
        android:text="OTHERS" 
        android:textSize="25dp" 
        app:icon="@drawable/others" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintEnd_toEndOf="parent" 
        app:layout_constraintHorizontal_bias="0.496" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintTop_toTopOf="@+id/imageView" 
        app:layout_constraintVertical_bias="0.658" /> 
 
    <Button 
        android:id="@+id/buttonResults" 
        android:layout_width="250dp" 
        android:layout_height="65dp" 
        android:backgroundTint="#36712B" 
        android:text="RESULTS" 
        android:textSize="25dp" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintEnd_toEndOf="parent" 
        app:layout_constraintHorizontal_bias="0.496" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintTop_toTopOf="@+id/imageView" 
        app:layout_constraintVertical_bias="0.911" /> 
 
</androidx.constraintlayout.widget.ConstraintLayout>